{
    "project_path": "/path/to/your/java/project",
    "deploy_path": "/path/to/jboss/standalone/deployments",
    "modules": {
        "core-ear": {
            "base_path": "core",
            "artifact_file": "core/ear/target/core.ear"
        },
        "common-jar": {
            "base_path": "common/lib",
            "artifact_file": "common/lib/target/common.jar"
        },
        "utils-jar": {
            "base_path": "utils",
            "artifact_file": "utils/target/utils.jar"
        },
        "api-war": {
            "base_path": "api",
            "artifact_file": "api/web/target/api.war"
        },
        "services-ear": {
            "base_path": "services",
            "artifact_file": "services/ear/target/services.ear"
        },
        "reports-ear": {
            "base_path": "reports",
            "artifact_file": "reports/ear/target/reports.ear"
        }
    },
    "profiles": [
        {
            "name": "BASE",
            "project_path": "",
            "deploy_path": "",
            "modules": [
                {"name": "core-ear"},
                {"name": "common-jar"},
                {"name": "utils-jar"}
            ]
        },
        {
            "name": "SERVICES",
            "modules": [
                {"name": "$BASE$"},
                {"name": "services-ear"},
                {"name": "api-war", "deploy_path": "/custom/deploy/path"}
            ]
        },
        {
            "name": "REPORTS",
            "modules": [
                {"name": "$BASE$", "deploy_path": "/another/deploy/path"},
                {"name": "reports-ear"}
            ]
        },
        {
            "name": "FULL",
            "modules": [
                {"name": "$SERVICES$"},
                {"name": "$REPORTS$"}
            ]
        }
    ]
}
