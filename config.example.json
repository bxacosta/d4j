{
    "project_home": "/path/to/your/java/project",
    "jboss_home": "/path/to/jboss/server",
    "deploy_path": "$jboss_home$/standalone/deployments",
    "modules": {
        "core-ear": {
            "module_path": "$project_home$/core",
            "artifact_file": "$project_home$/core/ear/target/core.ear"
        },
        "common-jar": {
            "module_path": "$project_home$/common/lib",
            "artifact_file": "$project_home$/common/lib/target/common.jar"
        },
        "utils-jar": {
            "module_path": "$project_home$/utils",
            "artifact_file": "$project_home$/utils/target/utils.jar"
        },
        "api-war": {
            "module_path": "$project_home$/api",
            "artifact_file": "$project_home$/api/web/target/api.war"
        },
        "services-ear": {
            "module_path": "$project_home$/services",
            "artifact_file": "$project_home$/services/ear/target/services.ear"
        },
        "reports-ear": {
            "module_path": "$project_home$/reports",
            "artifact_file": "$project_home$/reports/ear/target/reports.ear"
        }
    },
    "profiles": [
        {
            "name": "BASE",
            "modules": [
                {"name": "core-ear"},
                {"name": "common-jar"},
                {"name": "utils-jar"}
            ]
        },
        {
            "name": "SERVICES",
            "modules": [
                {"name": "$BASE$"},
                {"name": "services-ear"},
                {"name": "api-war", "deploy_path": "/custom/deploy/path"}
            ]
        },
        {
            "name": "REPORTS",
            "modules": [
                {"name": "$BASE$", "deploy_path": "/another/deploy/path"},
                {"name": "reports-ear"}
            ]
        },
        {
            "name": "FULL",
            "modules": [
                {"name": "$SERVICES$"},
                {"name": "$REPORTS$"}
            ]
        }
    ]
}
